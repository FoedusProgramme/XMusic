<resources>
    <declare-styleable name="ScrimView">
        <attr name="scrimColor" format="color|reference" />
    </declare-styleable>
    
    <attr name="originalSurfaceColor" format="color" />
    
    <declare-styleable name="PlayingIndicatorView">
        <attr name="barColor" format="color"/>
        <attr name="blockCount" format="integer"/>
        <attr name="blockSpacing" format="dimension"/>
    </declare-styleable>

    <declare-styleable name="RoundedImageView">
        <attr name="radius" format="dimension"/>
        <attr name="topLeftRadius" format="dimension"/>
        <attr name="topRightRadius" format="dimension"/>
        <attr name="bottomLeftRadius" format="dimension"/>
        <attr name="bottomRightRadius" format="dimension"/>
        <attr name="android:adjustViewBounds"/>
    </declare-styleable>
</resources>